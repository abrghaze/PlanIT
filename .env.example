PLANIT_APP_ENV=local
PLANIT_DEBUG=true
PLANIT_DATABASE_URL=postgresql+asyncpg://planit:planit_dev_only@localhost:5432/planit
PLANIT_ALLOWED_ORIGINS=["http://localhost:3000"]
PLANIT_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
PLANIT_REFRESH_TOKEN_PEPPER=replace-with-a-different-random-secret
PLANIT_ACCESS_TOKEN_TTL_MINUTES=15
PLANIT_REFRESH_TOKEN_TTL_DAYS=30
PLANIT_JWT_ISSUER=planit-api
PLANIT_JWT_AUDIENCE=planit-mobile
PLANIT_LOGIN_MAX_ATTEMPTS=5
PLANIT_LOGIN_WINDOW_MINUTES=15
PLANIT_LOGIN_LOCKOUT_MINUTES=15
PLANIT_S3_ENDPOINT_URL=http://localhost:3900
PLANIT_S3_REGION=garage
PLANIT_S3_BUCKET=planit-private
PLANIT_S3_ACCESS_KEY_ID=replace-after-garage-bootstrap
PLANIT_S3_SECRET_ACCESS_KEY=replace-after-garage-bootstrap
