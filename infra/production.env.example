# Copy this file outside Git as production.env, replace every required value,
# and run Compose with: docker compose --env-file production.env \
#   -f docker-compose.production.yml up -d

# Immutable release image produced by .github/workflows/release.yml.
PLANIT_API_IMAGE=ghcr.io/abrghaze/planit-api:0.10.0

# Bind to 127.0.0.1 when a same-host TLS proxy fronts the API. Use 0.0.0.0 only
# when the platform firewall/load balancer protects the container port.
PLANIT_API_BIND_ADDRESS=127.0.0.1
PLANIT_API_PORT=8000

PLANIT_APP_VERSION=0.10.0
PLANIT_DATABASE_URL=postgresql+asyncpg://planit:REPLACE_WITH_DATABASE_PASSWORD@database.example:5432/planit
PLANIT_ALLOWED_ORIGINS=["https://app.example.com"]
PLANIT_ACCESS_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PLANIT_REFRESH_TOKEN_PEPPER=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET
PLANIT_JWT_ISSUER=planit-api
PLANIT_JWT_AUDIENCE=planit-mobile
PLANIT_LOG_LEVEL=INFO

# Private S3-compatible storage is mandatory in production because receipt
# upload and complete account deletion depend on it.
PLANIT_S3_ENDPOINT_URL=https://s3.example.com
PLANIT_S3_REGION=auto
PLANIT_S3_BUCKET=planit-private
PLANIT_S3_ACCESS_KEY_ID=REPLACE_WITH_PRIVATE_BUCKET_ACCESS_KEY
PLANIT_S3_SECRET_ACCESS_KEY=REPLACE_WITH_PRIVATE_BUCKET_SECRET_KEY
